/*
 * Lariska 鼠标 —— ESB split peripheral 版本的 devicetree
 *
 * 与上游原版的差异（**鼠标自己的按键定义保持原样**）：
 *   * 5 个按键仍然是原来的 zmk,kscan-gpio-direct（按键位置 0~4 不变）；
 *   * 新增 esb_split：ESB 收发地址，必须与 dongle 的 config/corne.overlay 逐字节一致；
 *   * 新增 split_inputs 里的 mou0_split(reg=4)：指针事件经 ESB 上报给 dongle；
 *   * 原来指向 &mou0 的 input-listener 在 lariska.keymap 里禁用了（那是 central 角色的用法）。
 *
 * 关于按键位置：鼠标按键上报的是 key position 0~4。dongle 侧的 corne keymap
 * 把 0~4 专门留给鼠标按键，corne 自己的键位编号整体后移了 5 位（见
 * zmk-config 仓库的 config/corne.overlay 注释），所以这里什么都不用改。
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
// 报告率限速处理器的节点定义（原来在 lariska.keymap 里 include，挪到这里，
// 因为 ESB 版本下它挂在 &mou0_split 上，而 overlay 会比 keymap 先被处理）
#include <input/processors/report_rate_limit.dtsi>
#include "mouse_leds.dtsi"

/ {
    chosen {
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
		zmk,backlight = &backlight;
    }; 

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 7>;
        output-ohms = <400000>;
        full-ohms = <(1000000 + 400000)>;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <1>;

        map = <
            RC(0,0)
            RC(0,1)
            RC(0,2)
            RC(0,3)
            RC(0,4)
        >;
    };

    // 5 个鼠标按键：原样保留（键盘事件，位置 0~4）
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    /*
     * ESB 收发地址：这些是示例地址，必须与 dongle 的
     * config/corne.overlay 里的值逐字节一致，否则收不到。
     */
    esb_split {
        compatible = "zmk,esb-split";
        base-addr-0 = <0xE7 0xE7 0xE7 0xE7>;
        base-addr-1 = <0xC2 0xC2 0xC2 0xC2>;
        addr-prefix = <0xE7 0xC2 0xC3 0xC4 0xC5 0xC6 0xC7 0xC8>;
    };

    /*
     * ESB 事件路由：指针走 input 通道（reg=4），
     * dongle 侧要有相同 reg 的 zmk,input-split 节点。
     * 按键不需要这里——它们走 key position（见文件头说明）。
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        mou0_split: mou0_split@4 {
            compatible = "zmk,input-split";
            reg = <4>;
        };
    };

    // encoder: encoder {
    //     compatible = "alps,ec11";
    //     a-gpios = <&gpio0 1 (GPIO_ACTIVE_HIGH)>;
    //     b-gpios = <&gpio0 0 (GPIO_ACTIVE_HIGH)>;
    //     steps = <48>;
    //     status = "okay";
    // };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <24>;
    };

};

// 指针事件：peripheral 侧先用原来的限速处理器处理，再经 ESB 上报
&mou0_split {
    device = <&mou0>;
    input-processors = <&zip_report_rate_limit 1>;
};

&pinctrl {
	qdec_default: qdec_default {
		group1 {
			psels = <NRF_PSEL(QDEC_A, 0, 1)>,
			<NRF_PSEL(QDEC_B, 0, 0)>;
			// bias-pull-up;
		};
	};
	
	
	// need second set of pins defined if deep sleep is enabled
	qdec_sleep: qdec_sleep {
		group1 {
			psels = <NRF_PSEL(QDEC_A, 0, 1)>,
			<NRF_PSEL(QDEC_B, 0, 0)>;
			// bias-pull-up; // TODO: find out if this makes sense with low-power-enable
			low-power-enable;
		};
	};
};

// Set up the QDEC hardware based driver and give it the same label as the deleted node.
encoder: &qdec0 {
	status = "okay";
	led-pre = <0>;
	steps = <48>;
	pinctrl-0 = <&qdec_default>;
	pinctrl-1 = <&qdec_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 6)>,
			<NRF_PSEL(SPIM_MOSI, 0, 5)>,
			<NRF_PSEL(SPIM_MISO, 0, 4)>;
		};
	};
	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 6)>,
			<NRF_PSEL(SPIM_MOSI, 0, 5)>,
			<NRF_PSEL(SPIM_MISO, 0, 4)>;
			low-power-enable;
		};
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
    status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;

	mou0: pd@0 {
		compatible = "pixart,paw3395";
	    status = "okay";
		label = "MOU0";
		reg = <0>;
		spi-max-frequency = <4000000>;

		// paw3395 driver parameters
		irq-gpios = <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		// cpi-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		// cpi = <600 1200 2400 3200>;
		cpi = <1200>;                        // initial CPI (single value)
        // cpi-array = <600 1200 2400 3200>;  // optional multi-step CPI list
		// swap-xy; /* optional */
		invert-x; /* optional */
		// invert-y; /* optional */
		evt-type = <INPUT_EV_REL>;
		x-input-code = <INPUT_REL_X>;
		y-input-code = <INPUT_REL_Y>;
	};
};

